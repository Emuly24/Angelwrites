# =====================================================================================
#  AngelWrites: sample .env file
#
#  How to use it:
#   1. Copy this file and name the copy  .env  (dot env, no other name).
#   2. Fill in the values you have. Leave a line empty (or delete it) when you don't use it.
#   3. Upload .env to the site's main folder on InfinityFree (htdocs, next to index.php).
#      It is never put on GitHub and the automatic deploy never touches it.
#
#  Rules: one setting per line, NAME=value, no spaces around "=", no quotes needed.
#  Lines starting with # are notes and are ignored.
#  Never paste these values into chat, email or GitHub.
# =====================================================================================


# ---------- 1. Email (Zoho) -------------------------------------------------- REQUIRED
# The only one you must add. With it, sign-up emails, password resets, replies from the team
# and the newsletter all send from angelwrites@zohomail.com.
# Where: Zoho Mail > Settings > Security > App Passwords > the "AngelWrites" app password.
ZOHO_APP_PASSWORD=

# Leave these as they are unless something changes; they are the defaults already.
# ZOHO_USERNAME=angelwrites@zohomail.com
# ZOHO_FROM_NAME=AngelWrites
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=587
# Zoho accounts in Europe or India use smtp.zoho.eu or smtp.zoho.in instead.

# Where the site sends its own alerts (new members, contact messages...). Default: the Zoho inbox.
# ADMIN_EMAIL=angelwrites@zohomail.com


# ---------- 2. Site ----------------------------------------------------------- optional
# SITE_URL=https://angelwrites.gt.tc
# SITE_NAME=AngelWrites


# ---------- 3. Sign in with... ------------------------------------------------ optional
# Each button appears on the login and sign-up pages only when BOTH of its lines are filled.
# For every provider, the "redirect / callback URL" to enter on their website is:
#     https://angelwrites.gt.tc/social_login.php

# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com > My Apps > Create app > Facebook Login > Settings
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# GitHub: github.com > Settings > Developer settings > OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft (Outlook, Hotmail): portal.azure.com > App registrations > New registration
#   (supported accounts: "any organizational directory and personal Microsoft accounts")
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Telegram: in Telegram, open @BotFather > your bot > Bot Settings > Web Login
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# TikTok: developers.tiktok.com > Manage apps > Login Kit (they call the ID a "client key")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram: not possible. Meta closed Instagram sign-in for websites in December 2024.


# ---------- 4. Social accounts vault ------------------------------------------ optional
# Admin > Social accounts stores the sign-in details of AngelWrites' own Facebook, TikTok...
# pages, encrypted. Without this line the site makes its own key in the data folder, which is fine.
# If you prefer your own key: a long random phrase (40+ characters). Set it BEFORE saving any
# account details there; changing it later makes details saved earlier unreadable.
# SOCIAL_VAULT_KEY=


# ---------- 5. Private journals --------------------------------------------- recommended
# Members' journals are encrypted with this key (it is never in the database, so a backup alone
# cannot be read). Without it the site makes a key file in data/journal.key, which works, but a
# database backup restored on a NEW server without that file cannot open the journals.
# Best: set a long random phrase (40+ characters) now, and keep a copy in your password manager.
# Never change it later: journals written with the old key could no longer be opened.
# JOURNAL_KEY=


# ---------- 6. Rarely needed --------------------------------------------------- optional
# Lets a scheduled job send reading reminders over the web; any long random text.
# READER_CRON_KEY=
# Address members' email replies bounce to (default: noreply@angelwrites.gt.tc, no mailbox).
# MAIL_NOREPLY_ADDRESS=
