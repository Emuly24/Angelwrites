<FilesMatch "\.env$">
    Order allow,deny
    Deny from all
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
RewriteEngine On
# Allow the bot to fetch the clean /img/ URL, which routes internally to serve_og.php
RewriteRule ^img/([0-9]+)/?$ serve_og.php?id=$1 [L,QSA]