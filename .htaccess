<FilesMatch "\.env$">
    Order allow,deny
    Deny from all
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
<IfModule mod_rewrite.c>
RewriteEngine On
# Exempt social bots from image blocking rules
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot) [NC]
RewriteRule ^assets/uploads/poems/.*\.png$ - [L]
</IfModule>