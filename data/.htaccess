# S3 (F206): nothing in data/ (site.db, site.db-wal, site.db-shm) may be served over HTTP.
# The deploy excludes data/**, so this file is NOT uploaded automatically: upload it by hand
# to htdocs/data/.htaccess in the InfinityFree file manager (merge sequence, fix/security step).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
